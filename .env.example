# MERIDIAN HOSPITAL
# Environment Configuration Template
# Copy this file to .env.local for local development.
# Never commit private credentials, database passwords, or service-role keys.

# Supabase Project URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase Public Anonymous API Key (safe for browser client requests with RLS enabled)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Hospital Timezone Configuration
VITE_HOSPITAL_TIMEZONE=Asia/Kolkata
